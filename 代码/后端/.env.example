# 仅供152测试环境参考。复制到仓库外的私有环境文件并替换占位值。
# 程序不自动加载.env；使用systemd EnvironmentFile或进程环境注入。
APP_SURFACE=public
# test/acceptance始终限制短信白名单；production还强制安全Cookie、HTTPS来源与图片保护。
APP_ENV=test
QINGYE_ADDR=127.0.0.1:5180
DATABASE_URL=postgres://qingye_test:REPLACE_ME@127.0.0.1:5432/qingye_test?sslmode=disable
REDIS_URL=redis://:REPLACE_ME@127.0.0.1:6381/0
MEDIA_DIR=/var/lib/qingye-test/media
PUBLIC_BASE_URL=https://152.136.252.204:5179
ALLOWED_ORIGINS=https://152.136.252.204:5179
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# QQ私密资料使用另一把32字节随机密钥的Base64；public/admin共用，验收环境另配。
# 留空仅禁用私密资料写入/读取；配置后必须随数据库私有备份妥善保留。
PRODUCT_CREDENTIAL_KEY=
SECURE_COOKIES=true
# 短信仅public入口使用；注册/登录分别启用，默认均关闭。重置/换绑尚未开放。
# allowlist要求1..10个明确手机号；public只允许APP_ENV=production且白名单必须留空。
# 配置public不自动启用发送，不能用清空白名单来隐式开放。凭据不会从OSS配置回退读取。
SMS_ACCESS_MODE=allowlist
SMS_REGISTER_ENABLED=false
SMS_LOGIN_ENABLED=false
SMS_LOGIN_SCHEME=qingye-test-login
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=恒创联众
SMS_REGISTER_TEMPLATE=100001
SMS_REGISTER_SCHEME=qingye-test-register
SMS_ALLOWED_PHONES=
# 滚动24小时全站发送预算；在供应商请求前预留，失败不自动返还。
SMS_DAILY_LIMIT=20

# 每进程配置范围：DB连接1..50，Redis普通命令池1..100，普通HTTP并行1..2048。
# 聊天PubSub使用额外长连接，由聊天租约限额控制。
DB_MAX_CONNS=5
REDIS_POOL_SIZE=5
MAX_CONCURRENT_REQUESTS=128
# 普通API期限1s..60s；媒体/上传请求固定60s，仍受HTTP服务器读写超时约束。
REQUEST_TIMEOUT=15s
# 单文件默认10 MiB，允许1..67108864字节；不限制商品图集总张数。
MAX_UPLOAD_BYTES=10485760
# 健康检查2槽、密码比较2槽为代码固定限制，无对应环境变量。

# 当前测试站已启用可信IP证书；证书路径须存在且仅服务账号可读。
# WebTransport使用UDP，同端口TCP由HTTPS反向代理提供服务。
CHAT_WT_ADDR=0.0.0.0:5179
CHAT_WT_URL=https://152.136.252.204:5179/chat
CHAT_WT_CERT=/etc/qingye-test/tls/current/fullchain.pem
CHAT_WT_KEY=/etc/qingye-test/tls/current/privkey.pem
CHAT_WT_PIN_CERTIFICATE=false

# 管理API使用独立进程、独立私有环境文件；将相应字段替换为：
# APP_SURFACE=admin
# QINGYE_ADDR=127.0.0.1:5182
# PUBLIC_BASE_URL=https://152.136.252.204:5181
# ALLOWED_ORIGINS=https://152.136.252.204:5181
# CHAT_WT_ADDR=0.0.0.0:5181
# CHAT_WT_URL=https://152.136.252.204:5181/chat
# SESSION_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# SECURE_COOKIES=true
# 两端共用业务数据，但Cookie名称、会话及上传票据的audience隔离。
# 管理来源列表不要加入用户端来源；连接池与请求容量按各进程分别计算。

# R20仅纳管开启后的新商品图片；历史原图复制/预备读取另行维护。
# public/admin必须一致，先在acceptance验证再为test启用。所有密钥只放仓库外。
MEDIA_R20_ENABLED=false
MEDIA_R20_ENVIRONMENT=test
# 历史图只有已校验副本登记完成后才能启用OSS读取；要求R20存储与MEDIA_SAFETY_ENABLED均开启。
MEDIA_LEGACY_OSS_READ_ENABLED=false
# 仅APP_ENV和MEDIA_R20_ENVIRONMENT均为production时可接管原历史商品图。
# 接管时精确设为qingye-test/media/；测试和验收环境留空，不改变新R20路径。
MEDIA_LEGACY_OBJECT_PREFIX=
# 生产接管后测试环境必须设false，并由OSS云权限独立禁止测试服务器删除原图。
# 禁用只阻止legacy OSS物理删除，任务保留待重试，不能记录成已删除。
MEDIA_LEGACY_OSS_DELETE_ENABLED=true
# 默认true；迁入生产快照时先暂停媒体清理/生命周期任务，核对所有权与到期时间后再开启。
# 此开关不改变API读权限，也不暂停推荐、聊天及会话维护。
MEDIA_WORKERS_ENABLED=true
MEDIA_R20_MIN_FREE_BYTES=2147483648
MEDIA_STAGE_CAPACITY_PATH=/var/lib/qingye-storage
MEDIA_STAGE_ENDPOINT=http://127.0.0.1:8333
MEDIA_STAGE_BUCKET=qingye-media
MEDIA_STAGE_ACCESS_KEY_ID=
MEDIA_STAGE_ACCESS_KEY_SECRET=
MEDIA_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
MEDIA_OSS_BUCKET=qingye-images-20261
MEDIA_OSS_ACCESS_KEY_ID=
MEDIA_OSS_ACCESS_KEY_SECRET=
# 阿里云北京生产环境后续可用oss-cn-beijing-internal，浏览器签名仍走外网域名。
# 商品图片主机须在静态站 CSP 的 img-src、connect-src 中精确放行。
# OSS 跨域规则允许正式用户站及管理站的 Origin 执行 GET，以便浏览器保存已授权的商品图。

# 图片保护覆盖本机读取和 OSS 链接签发；公开商品直连须同时开启此保护。
# secret仅放服务端私有环境文件；正式运行拒绝供应商测试密钥。
MEDIA_SAFETY_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=152.136.252.204
# 令牌桶容量；默认补充速率为主体2次/秒、硬限制10次/秒、IP20次/秒。
MEDIA_READ_BURST=120
MEDIA_READ_HARD_BURST=600
MEDIA_READ_IP_BURST=1200
MEDIA_READ_MAX_SUBJECTS=10000

# R24：响应密钥签发后3600秒轮换，旧密钥保留120秒；可信本地图正文免额外AES。
# 开启后业务客户端必须初始化协议，不能以缺少请求头要求明文降级。
RESPONSE_CRYPTO_ENABLED=false
# 新版前端可获取 60 秒 OSS 商品图片链接，旧版前端仍使用 5 秒链接。草稿与私有媒体保留原访问控制。
MEDIA_DELIVERY_ENABLED=false

# 生产配置应另建私有文件，替换全部环境专用地址、存储、密钥和TLS路径，不能直接复用本示例。
# APP_ENV=production
# SMS_ACCESS_MODE=public
# SMS_ALLOWED_PHONES=
# SMS_REGISTER_ENABLED=false
# SMS_LOGIN_ENABLED=false
# 生产短信方案需显式声明为供应商已配置且互不相同的方案，协议发布就绪后才开启对应能力。
# SECURE_COOKIES=true
# ALLOWED_ORIGINS=https://实际主机:独立端口
# MEDIA_SAFETY_ENABLED=true
# CHAT_WT_PIN_CERTIFICATE=false
# MEDIA_R20_ENVIRONMENT=production
