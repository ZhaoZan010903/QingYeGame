# Integration environment only. Copy outside the repository and replace placeholders.
APP_SURFACE=public
QINGYE_ADDR=127.0.0.1:5180
DATABASE_URL=postgres://qingye_test:REPLACE_ME@127.0.0.1:5432/qingye_test?sslmode=disable
REDIS_URL=redis://:REPLACE_ME@127.0.0.1:6381/0
MEDIA_DIR=/var/lib/qingye-test/media
PUBLIC_BASE_URL=http://127.0.0.1:5179
ALLOWED_ORIGINS=http://127.0.0.1:5179
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SECURE_COOKIES=false
SMS_MODE=disabled
MAX_UPLOAD_BYTES=10485760

# Start the administrator API as a separate process with its own environment file:
# APP_SURFACE=admin
# QINGYE_ADDR=127.0.0.1:5182
# PUBLIC_BASE_URL=http://127.0.0.1:5181
# ALLOWED_ORIGINS=http://127.0.0.1:5181
# Both APIs share business data, but their Cookie names, session audiences and
# upload-ticket audiences differ. Do not add the public origin to the admin list.
# IP-only integration currently uses HTTP; set SECURE_COOKIES=true when HTTPS is configured.
