[Unit]
Description=QingYe production user frontend on port 5179
After=network.target qingye-production-api.service

[Service]
Type=simple
RuntimeDirectory=qingye-production/public
RuntimeDirectoryMode=0755
StateDirectory=qingye-production/nginx/public
StateDirectoryMode=0755
LogsDirectory=qingye-production/public
LogsDirectoryMode=0755
ExecStartPre=/www/server/nginx/sbin/nginx -t -p /var/lib/qingye-production/nginx/public/ -c /etc/qingye-production/nginx.conf
ExecStart=/www/server/nginx/sbin/nginx -p /var/lib/qingye-production/nginx/public/ -c /etc/qingye-production/nginx.conf -g "daemon off;"
ExecReload=/www/server/nginx/sbin/nginx -t -p /var/lib/qingye-production/nginx/public/ -c /etc/qingye-production/nginx.conf
ExecReload=/www/server/nginx/sbin/nginx -p /var/lib/qingye-production/nginx/public/ -c /etc/qingye-production/nginx.conf -s reload
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/qingye-production/public /var/lib/qingye-production/nginx/public /var/log/qingye-production/public
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
