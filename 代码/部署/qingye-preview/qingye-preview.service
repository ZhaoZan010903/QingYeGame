[Unit]
Description=QingYeGame HTML preview on port 5178
After=network.target

[Service]
Type=simple
RuntimeDirectory=qingye-preview
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/nginx -t -c /etc/qingye-preview/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/qingye-preview/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/qingye-preview/nginx.conf -s reload
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/qingye-preview /var/lib/qingye-preview /var/log/qingye-preview
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
