# Documentation example only. No listener is enabled unless CHAT_WT_ADDR is set.
# Use separate public/admin processes and preserve their existing auth configuration.
# Local public process (UDP, loopback only):
CHAT_WT_ADDR=127.0.0.1:5443
CHAT_WT_URL=https://127.0.0.1:5443/chat
CHAT_WT_CERT=/private/qingye-local-tls/cert.pem
CHAT_WT_KEY=/private/qingye-local-tls/key.pem
CHAT_WT_PIN_CERTIFICATE=true
# Local admin process: use 127.0.0.1:5444 and https://127.0.0.1:5444/chat.
# Production/test publication remains paused. A future public listener requires:
# 1. Explicit publication authorization and approved domain/UDP port.
# 2. A publicly trusted certificate; CHAT_WT_PIN_CERTIFICATE=false.
# 3. Exact per-surface ALLOWED_ORIGINS and matching CSP connect-src.
# 4. HTTP/3 CONNECT/WebTransport support end to end; ordinary HTTP proxy_pass is insufficient.
