[Unit]
Description=QingYe independent React admin frontend on port 5181
After=network.target qingye-test-admin-api.service

[Service]
Type=simple
RuntimeDirectory=qingye-test-admin-web
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/nginx -t -c /etc/qingye-test/admin-nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/qingye-test/admin-nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/qingye-test/admin-nginx.conf -s reload
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/qingye-test-admin-web /var/lib/qingye-test-admin-web /var/log/qingye-test-admin-web
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
